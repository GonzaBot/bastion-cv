# Copiar a .env y cargar antes de arrancar:  set -a; . ./.env; set +a
CLAVE_SECRETA=cambiar_por_python3_-c_import_secrets_print_secrets.token_hex_32
ORIGENES=http://localhost:8000,http://127.0.0.1:8000
# Poner en 1 SOLO si hay un proxy inverso que reescribe X-Forwarded-For.
DETRAS_DE_PROXY=0

# Panel de lectura del buzón (GET /admin/mensajes). Sin ADMIN_CLAVE el panel
# queda deshabilitado (503), no abierto. Basic Auth manda la clave en claro
# salvo que se sirva sobre HTTPS: no reutilizar una clave de otro lado.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambiar_por_python3_-c_import_secrets_print_secrets.token_hex_16
